// CANONICAL SOURCE: packages/db/prisma/schema.prisma
// KEEP ALL 3 SCHEMAS IN SYNC — run `prisma validate` after changes

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum JobStatus {
  PENDING
  PROCESSING
  QA_PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum IterationStatus {
  RUNNING
  PASSED
  FAILED
  RETRYING
}

enum JobType {
  CATALOG_VARIANTS
  LIFESTYLE_SCENES
  VIDEO_GENERATION
}

enum Role {
  ADMIN
  USER
}

// ── Gemini-first generation strategy enum ─────────────────────────────────────
// Stability AI strategies have been removed from code, but kept in enum for DB backwards compatibility.
enum GenerationStrategy {
  GEMINI_IMAGE_EDIT     // gemini-3-pro-image (color variants)
  GEMINI_LIFESTYLE      // gemini-2.0-flash (lifestyle scene generation)
  VEO_VIDEO             // veo-3.1-generate-preview (product showcase video)
  GEMINI_SPIN           // gemini-2.0-flash (360° spin frames)
  HUE_SHIFT             // Pure local HSL shift (no AI, free, for testing only)
  // Legacy variants kept to prevent Postgres enum drop errors:
  STABILITY_SEARCH_REPLACE
  SDXL_CONTROLNET
  FLUX_REDUX
  GPT_IMAGE_EDIT
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id               Int             @id @default(autoincrement())
  email            String          @unique
  passwordHash     String?
  twoFactorEnabled Boolean         @default(false)
  name             String?
  emailVerified    DateTime?
  image            String?
  role             Role            @default(USER)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  jobs             Job[]
  passwordResets   PasswordReset[]
  accounts         Account[]
  sessions         Session[]
}

model Job {
  id             Int               @id @default(autoincrement())
  name           String
  jobType        JobType           @default(CATALOG_VARIANTS)
  status         JobStatus         @default(PENDING)
  currentGoal    String?
  statusHistory  Json?
  progress       Float             @default(0)
  errorMessage   String?
  errorStack     String?
  retryCount     Int               @default(0)
  maxRetries     Int               @default(3)
  storagePrefix  String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userId         Int
  user           User              @relation(fields: [userId], references: [id])
  assets         Asset[]
  iterations     Iteration[]
  events         JobEvent[]
  promptId       Int?              @unique
  prompt         PromptTemplate?   @relation(fields: [promptId], references: [id])
  generation     Generation?
  generationConfig GenerationConfig?
  providerId     Int?
  provider       AiProvider?       @relation(fields: [providerId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model Asset {
  id               Int      @id @default(autoincrement())
  type             String   // 'original' | 'variant' | 'grid' | 'video' | 'spin' | 'spin-frame' | 'crop' | 'lifestyle' | 'processed'
  path             String
  status           String   // 'pending' | 'done' | 'approved' | 'error'
  clipScore        Float?
  dinov2Score      Float?
  ssimScore        Float?
  aggregateScore   Float?
  originalAssetId  Int?
  originalAsset    Asset?   @relation("AssetVersions", fields: [originalAssetId], references: [id])
  versions         Asset[]  @relation("AssetVersions")
  jobId            Int
  job              Job      @relation(fields: [jobId], references: [id])

  // Performance: queries like findFirst({ where: { jobId, type } }) are very common
  @@index([jobId])
  @@index([jobId, type])
  @@index([jobId, type, status])
}

model PromptTemplate {
  id      Int    @id @default(autoincrement())
  name    String
  content String
  job     Job?
}

model Generation {
  id       Int     @id @default(autoincrement())
  metadata Json?
  jobId    Int     @unique
  job      Job     @relation(fields: [jobId], references: [id])
}

// ── Gemini-first GenerationConfig ─────────────────────────────────────────────
// Replaced Stability AI fields with Gemini-specific configuration.
model GenerationConfig {
  id                Int                @id @default(autoincrement())
  jobId             Int                @unique
  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Gemini model selection
  strategy          GenerationStrategy @default(GEMINI_IMAGE_EDIT)
  geminiImageModel  String             @default("gemini-3-pro-image")
  geminiVideoModel  String             @default("veo-3.1-generate-preview")
  // Grid configuration
  colors            Json               @default("[]")
  gridCols          Int                @default(4)
  gridRows          Int                @default(3)
  // Video configuration
  videoEnabled      Boolean            @default(false)
  videoPrompt       String?
  // Spin configuration
  spinEnabled       Boolean            @default(false)
  spinFrames        Int                @default(36)
  fps               Int                @default(12)
  // Post-processing
  cropsEnabled      Boolean            @default(true)
  lifestyleEnabled  Boolean            @default(false)
  // Files API cache (P2.8) — avoids re-uploading reference image to Google on every run
  filesApiUri       String?            // Cached Google Files API URI
  filesApiExpiry    DateTime?          // URI expires after 48h
  // Metadata
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
}


model Iteration {
  id             Int             @id @default(autoincrement())
  jobId          Int
  job            Job             @relation(fields: [jobId], references: [id])
  prompt         String
  critique       String?
  status         IterationStatus @default(RUNNING)
  assetPath      String?
  clipScore      Float?
  aggregateScore Float?
  createdAt      DateTime        @default(now())
}

model JobEvent {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  event     String
  message   String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([jobId])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model AiProvider {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  // API key stored AES-256-GCM encrypted at rest (see lib/crypto.ts)
  // Format: "enc:<iv_hex>:<authTag_hex>:<ciphertext_hex>" or plain text for legacy/mock
  apiKey  String
  default Boolean @default(false)
  jobs    Job[]
}

// ── Application settings (replaces the __app_settings__ AiProvider hack) ─────
model AppSettings {
  id               Int    @id @default(1) // singleton
  geminiImageModel String @default("gemini-3-pro-image")
  geminiVideoModel String @default("veo-3.1-generate-preview")
  defaultGridCols  Int    @default(4)
  defaultGridRows  Int    @default(3)
  updatedAt        DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
